{
  "name": "lootopia",
  "version": "0.1.0",
  "private": true,
  "description": "Lootopia - geolocated treasure hunt platform (PWA + API)",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@lootopia/api",
    "dev:web": "npm run dev --workspace=@lootopia/web",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint-react/eslint-plugin": "5.30.6",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/jest": "^30.0.0",
    "@types/node": "24.19.2",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "eslint": "10.15.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "eslint-plugin-regexp": "3.3.3",
    "eslint-plugin-security": "4.2.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "80.0.0",
    "globals": "17.14.0",
    "jest": "30.5.2",
    "jiti": "2.7.0",
    "semantic-release": "25.0.9",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0"
  }
}
