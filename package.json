{
  "name": "lootopia",
  "version": "0.1.0",
  "private": true,
  "description": "Lootopia - geolocated treasure hunt platform (PWA + API)",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@lootopia/api",
    "dev:web": "npm run dev --workspace=@lootopia/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts}": [
      "prettier --write",
      "eslint --max-warnings=0 --no-warn-ignored"
    ],
    "*.{js,mjs,cjs,json,md,yml,yaml,css,html}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint-react/eslint-plugin": "5.30.6",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.1",
    "@vitest/eslint-plugin": "1.6.28",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "eslint-plugin-regexp": "3.3.3",
    "eslint-plugin-security": "4.2.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "80.0.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "lint-staged": "17.6.2",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1"
  }
}
