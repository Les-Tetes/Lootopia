{
  "name": "@lootopia/api",
  "version": "0.1.0",
  "private": true,
  "description": "Lootopia REST API (NestJS)",
  "type": "commonjs",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
